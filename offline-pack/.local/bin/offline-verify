#!/usr/bin/env bash
set -euo pipefail

LIB="${XDG_DATA_HOME:-$HOME/.local/share}/offline-pack/offline-pack-lib"
# shellcheck source=/dev/null
source "$LIB"

usage() {
  echo "Usage: offline-verify <offline-pack-dir-or-tar.xz>"
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

[[ $# -eq 1 ]] || {
  usage
  exit 1
}

offline_require_cmds xz base64 sha256sum awk mktemp cp tar find sort head

PACK_INPUT="$1"
TMP_DIR="$(mktemp --directory)"
trap 'rm --recursive --force "$TMP_DIR"' EXIT

PACK_DIR="$(offline_resolve_pack_dir "$PACK_INPUT" "$TMP_DIR")"
offline_require_pack_layout "$PACK_DIR"

echo "[1/4] Verifying base64 part checksums"
offline_verify_part_checksums "$PACK_DIR"

echo "[2/4] Reconstructing payload"

TMP_PAYLOAD="${TMP_DIR}/payload.xz"
offline_copy_or_decode_payload "$PACK_DIR" "$TMP_PAYLOAD"

echo "[3/4] Testing xz integrity"
xz --test -- "$TMP_PAYLOAD"

echo "[4/4] Done"
echo
echo "Offline package verified"
echo "Package input:     $PACK_INPUT"
echo "Package directory: $PACK_DIR"
echo "Result: OK"
