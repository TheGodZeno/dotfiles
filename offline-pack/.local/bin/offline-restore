#!/usr/bin/env bash
set -euo pipefail

LIB="${XDG_DATA_HOME:-$HOME/.local/share}/offline-pack/offline-pack-lib"
# shellcheck source=/dev/null
source "$LIB"

usage() {
  cat <<EOF
Usage:
  offline-restore <offline-pack-dir-or-tar.xz> [restore-dir]
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

[[ $# -ge 1 && $# -le 2 ]] || {
  usage
  exit 1
}

offline_require_cmds xz base64 sha256sum tar awk find sort tee mktemp cp basename xargs

PACK_INPUT="$1"

# A .tar.xz bundle is extracted into TMP_DIR and treated exactly like a package
# directory. Direct package directories pass through unchanged.
TMP_DIR="$(mktemp --directory)"
trap 'rm --recursive --force "$TMP_DIR"' EXIT

PACK_DIR="$(offline_resolve_pack_dir "$PACK_INPUT" "$TMP_DIR")"
offline_require_pack_layout "$PACK_DIR"

# If restoring from a bundle and no output path is given, avoid restoring into
# the temporary extraction directory that will be deleted on exit.
if [[ $# -eq 2 ]]; then
  RESTORE_DIR="$2"
elif offline_pack_is_bundle "$PACK_INPUT"; then
  RESTORE_DIR="${PWD}/$(basename -- "${PACK_INPUT%.tar.xz}")-restored"
else
  RESTORE_DIR="${PACK_DIR}/restored"
fi

LOGS_DIR="${PACK_DIR}/logs"
CHECKSUMS_DIR="${PACK_DIR}/checksums"
MANIFEST_FILE="${PACK_DIR}/manifest.txt"

offline_make_dirs "$RESTORE_DIR" "$LOGS_DIR" "$CHECKSUMS_DIR"

# From here on, stdout/stderr are written both to the terminal and restore log.
LOG_FILE="${LOGS_DIR}/restore.out"
exec > >(tee "$LOG_FILE") 2>&1

# Mode tells restore whether the xz payload expands to one file or to a tar
# archive containing the original directory structure.
MODE="$(offline_manifest_value "$MANIFEST_FILE" "Mode")"
PAYLOAD_FILE="$(offline_pack_payload_file "$PACK_DIR")"

TMP_PAYLOAD="${TMP_DIR}/payload.xz"

echo "[1/5] Reading package"
echo "Package input:     $PACK_INPUT"
echo "Package directory: $PACK_DIR"
echo "Restore directory: $RESTORE_DIR"
echo "Mode:              $MODE"
echo

if [[ -f "$PAYLOAD_FILE" ]]; then
  echo "[2/5] Using existing compressed payload"
else
  echo "[2/5] Reconstructing compressed payload from base64 parts"
fi
offline_copy_or_decode_payload "$PACK_DIR" "$TMP_PAYLOAD"

# Test before writing user-visible restored files.
echo "[3/5] Testing xz payload"
xz --test -- "$TMP_PAYLOAD"

echo "[4/5] Restoring content"
case "$MODE" in
  file)
    # File mode has no original filename in the payload, so use a stable name.
    xz --decompress --stdout -- "$TMP_PAYLOAD" > "${RESTORE_DIR}/restored-file"
    ;;
  archive)
    # Archive mode preserves the original paths from the tar stream.
    tar --extract --xz --file="$TMP_PAYLOAD" --directory="$RESTORE_DIR"
    ;;
  *)
    offline_die "unknown mode in manifest: $MODE"
    ;;
esac

# This is useful for comparing restored output with another copy later.
echo "[5/5] Writing restored checksums"
offline_write_tree_checksums "$RESTORE_DIR" "${CHECKSUMS_DIR}/restored.sha256"

echo
echo "Offline restore completed"
echo "Package directory: $PACK_DIR"
echo "Restore directory: $RESTORE_DIR"
echo "Log file:          $LOG_FILE"
