#!/usr/bin/env bash

offline_die() {
  echo "ERROR: $*" >&2
  return 1
}

offline_require_cmd() {
  command -v "$1" >/dev/null 2>&1 || offline_die "required command not found: $1"
}

offline_require_cmds() {
  local cmd

  for cmd in "$@"; do
    offline_require_cmd "$cmd" || return 1
  done
}

offline_to_bytes() {
  local value="$1"

  case "$value" in
    *Ki|*Mi|*Gi|*Ti)
      numfmt --from=iec-i -- "$value"
      ;;
    *K|*M|*G|*T)
      numfmt --from=si -- "$value"
      ;;
    *[!0-9]*)
      offline_die "invalid size: $value. Use examples like 150Mi, 150M, 3Gi, 3G"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

offline_human_bytes() {
  numfmt --to=iec-i --suffix=B -- "$1"
}

offline_manifest_value() {
  local manifest_file="$1"
  local key="$2"

  awk -F': +' -v key="$key" '$1 == key {print $2; exit}' "$manifest_file"
}

offline_make_dirs() {
  mkdir --parents -- "$@"
}

offline_latest_pack() {
  local root="${1:-${XDG_STATE_HOME:-$HOME/.local/state}/offline-packs}"

  find "$root" -maxdepth 1 -type d -name 'offline-pack-*' 2>/dev/null \
    | sort \
    | tail --lines=1
}

offline_resolve_pack_dir() {
  local pack_input="$1"
  local tmp_dir="$2"
  local pack_dir

  # Commands accept either the unpacked package directory or the full bundle.
  # Bundles are extracted to the caller-owned temporary directory.
  if [[ -d "$pack_input" ]]; then
    printf '%s\n' "$pack_input"
  elif [[ -f "$pack_input" ]]; then
    tar --extract --xz --file="$pack_input" --directory="$tmp_dir"
    pack_dir="$(find "$tmp_dir" -mindepth 1 -maxdepth 1 -type d | sort | head --lines=1)"
    [[ -n "$pack_dir" ]] || offline_die "bundle archive did not contain a package directory: $pack_input"
    printf '%s\n' "$pack_dir"
  else
    offline_die "package not found: $pack_input"
  fi
}

offline_pack_is_bundle() {
  local pack_input="$1"

  [[ -f "$pack_input" && ! -d "$pack_input" ]]
}

offline_require_pack_layout() {
  local pack_dir="$1"
  local payload_dir="${pack_dir}/payload"
  local manifest_file="${pack_dir}/manifest.txt"

  [[ -d "$payload_dir" ]] || offline_die "payload directory not found: $payload_dir"
  [[ -f "$manifest_file" ]] || offline_die "manifest not found: $manifest_file"
}

offline_pack_payload_file() {
  local pack_dir="$1"
  local manifest_file="${pack_dir}/manifest.txt"
  local payload_dir="${pack_dir}/payload"
  local payload_basename

  payload_basename="$(offline_manifest_value "$manifest_file" "Payload file")"
  [[ -n "$payload_basename" ]] || offline_die "payload file missing from manifest: $manifest_file"
  printf '%s/%s\n' "$payload_dir" "$payload_basename"
}

offline_copy_or_decode_payload() {
  local pack_dir="$1"
  local output_file="$2"
  local payload_dir="${pack_dir}/payload"
  local payload_file

  payload_file="$(offline_pack_payload_file "$pack_dir")" || return 1

  # Prefer the kept xz payload when present. If --no-keep-xz was used, rebuild
  # the same payload from the transfer-safe base64 parts.
  if [[ -f "$payload_file" ]]; then
    cp -- "$payload_file" "$output_file"
  else
    offline_decode_parts_to_file "$payload_dir" "$output_file"
  fi
}

offline_verify_part_checksums() {
  local pack_dir="$1"
  local parts_sha="${pack_dir}/checksums/parts.sha256"

  if [[ -f "$parts_sha" ]]; then
    (
      cd "$pack_dir" || return 1
      sha256sum --check "checksums/parts.sha256"
    )
  else
    echo "WARN: parts.sha256 not found"
  fi
}

offline_write_tree_checksums() {
  local root_dir="$1"
  local output_file="$2"

  find "$root_dir" -type f -print0 \
    | sort --zero-terminated \
    | xargs --null sha256sum \
    > "$output_file"
}

offline_decode_parts_to_file() {
  local payload_dir="$1"
  local output_file="$2"
  local part

  shopt -s nullglob
  local parts=( "${payload_dir}"/part-*.b64 )
  shopt -u nullglob

  [[ "${#parts[@]}" -gt 0 ]] || offline_die "no part-*.b64 files found in: $payload_dir"

  : > "$output_file"

  for part in "${parts[@]}"; do
    echo "Decoding: $part"
    base64 --decode -- "$part" >> "$output_file"
  done
}

offline_write_file_checksum() {
  local file="$1"
  local output_file="$2"
  local file_realpath
  local parent
  local name

  file_realpath="$(realpath -- "$file")"
  parent="$(dirname -- "$file_realpath")"
  name="$(basename -- "$file_realpath")"

  (
    cd "$parent" || return 1
    sha256sum -- "$name"
  ) > "$output_file"
}

offline_append_input_checksums() {
  local output_file="$1"
  shift

  local item
  local item_realpath
  local parent
  local name

  : > "$output_file"

  for item in "$@"; do
    item_realpath="$(realpath -- "$item")"
    parent="$(dirname -- "$item_realpath")"
    name="$(basename -- "$item_realpath")"

    if [[ -f "$item_realpath" ]]; then
      (
        cd "$parent" || return 1
        sha256sum -- "$name"
      ) >> "$output_file"

    elif [[ -d "$item_realpath" ]]; then
      (
        cd "$parent" || return 1
        find "$name" -type f -print0 \
          | sort --zero-terminated \
          | xargs --null sha256sum
      ) >> "$output_file"
    fi
  done
}

offline_total_input_size_bytes() {
  local total=0
  local item
  local size

  for item in "$@"; do
    size="$(du --bytes --summarize -- "$item" | awk '{print $1}')"
    total=$((total + size))
  done

  printf '%s\n' "$total"
}

offline_write_inputs_file() {
  local output_file="$1"
  shift

  local item

  : > "$output_file"

  for item in "$@"; do
    realpath -- "$item" >> "$output_file"
  done
}

offline_base64_split_parts() {
  local payload_dir="$1"
  local part

  for part in "${payload_dir}"/part-*; do
    [[ -f "$part" ]] || continue
    base64 --wrap=0 -- "$part" > "${part}.b64"
    rm --force -- "$part"
  done
}

offline_sum_b64_payload_bytes() {
  local payload_dir="$1"

  find "$payload_dir" -maxdepth 1 -type f -name 'part-*.b64' -printf '%s\n' \
    | awk '{s+=$1} END {print s+0}'
}

offline_count_parts() {
  local payload_dir="$1"

  find "$payload_dir" -maxdepth 1 -type f -name 'part-*.b64' \
    | wc --lines
}
