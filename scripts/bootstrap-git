#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NEEDS_EDIT=0

info() {
  printf '  -> %s\n' "$1"
}

warn() {
  printf '  !! %s\n' "$1"
}

seed_file() {
  local src="$1"
  local dst="$2"

  info "checking ${dst#"$ROOT"/}"

  if [[ ! -e "$dst" && ! -r "$src" ]]; then
    warn "missing template: ${src#"$ROOT"/}"
    return 1
  fi

  if [[ ! -e "$dst" ]]; then
    echo "creating ${dst#"$ROOT"/} from ${src#"$ROOT"/}"
    cp "$src" "$dst"
    NEEDS_EDIT=1
  else
    echo "keeping ${dst#"$ROOT"/}"
  fi
}

echo "==> Checking local Git config files"

if [[ -e "$ROOT/git/.gitconfig-work" && ! -e "$ROOT/git/.gitconfig.work" ]]; then
  info "renaming git/.gitconfig-work to git/.gitconfig.work"
  mv "$ROOT/git/.gitconfig-work" "$ROOT/git/.gitconfig.work"
else
  info "legacy git/.gitconfig-work rename not needed"
fi

seed_file "$ROOT/examples/gitconfig.local.example" "$ROOT/git/.gitconfig.local"
seed_file "$ROOT/examples/gitconfig.work.example" "$ROOT/git/.gitconfig.work"

if grep --extended-regexp --quiet 'YOUR_(NAME|PERSONAL_EMAIL)' "$ROOT/git/.gitconfig.local"; then
  warn "git/.gitconfig.local still has placeholder identity values"
  NEEDS_EDIT=1
else
  info "git/.gitconfig.local identity values look filled in"
fi

if grep --extended-regexp --quiet 'YOUR_(WORK_NAME|WORK_EMAIL)' "$ROOT/git/.gitconfig.work"; then
  warn "git/.gitconfig.work still has placeholder identity values"
  NEEDS_EDIT=1
else
  info "git/.gitconfig.work identity values look filled in"
fi

if [[ "$NEEDS_EDIT" -eq 1 ]]; then
  echo
  echo "Edit these local Git config files before committing:"
  echo "  ${ROOT#"$HOME"/}/git/.gitconfig.local"
  echo "  ${ROOT#"$HOME"/}/git/.gitconfig.work"
  echo
else
  echo "Local Git config files are ready."
fi
