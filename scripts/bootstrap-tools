#!/usr/bin/env bash
set -euo pipefail

has() { command -v "$1" >/dev/null 2>&1; }

info() {
  printf '  -> %s\n' "$1"
}

warn() {
  printf '  !! %s\n' "$1"
}

install_fedora() {
  info "installing Fedora/RHEL packages with dnf"
  sudo dnf --assumeyes install \
    git stow curl unzip tar xz \
    bash-completion ca-certificates openssh-clients \
    eza fd-find ripgrep fzf bat jq yq git-delta shellcheck shfmt \
    tmux direnv zoxide neovim
}

install_ubuntu() {
  info "updating apt package indexes"
  sudo apt-get update
  info "installing Ubuntu/Debian packages with apt-get"
  sudo apt-get install --yes \
    git stow curl unzip tar xz-utils \
    bash-completion ca-certificates openssh-client \
    eza fd-find ripgrep fzf bat jq git-delta shellcheck shfmt \
    tmux direnv zoxide neovim
}

install_mise() {
  if ! has mise; then
    info "mise not found; installing to ~/.local/bin"
    curl https://mise.run | sh
  else
    info "mise already installed: $(command -v mise)"
  fi
}

install_starship() {
  if ! has starship; then
    info "starship not found; installing with official installer"
    curl --silent --show-error https://starship.rs/install.sh | sh -s -- --yes
  else
    info "starship already installed: $(command -v starship)"
  fi
}

case "${1:-}" in
  --no-packages)
    echo "==> Installing user-level tools only"
    install_mise
    install_starship
    exit 0
    ;;
esac

echo "==> Installing bootstrap tools"
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  info "detected distro: ${ID:-unknown}"
  case "${ID:-}" in
    fedora|rhel|centos) install_fedora ;;
    ubuntu|debian) install_ubuntu ;;
    *) warn "unknown distro: ${ID:-unknown}; install packages manually" ;;
  esac
else
  warn "cannot read /etc/os-release; install packages manually"
fi

install_mise
install_starship
echo "==> Bootstrap tools ready"
